# Copie ce fichier en .env puis renseigne UN des deux identifiants Claude.

# Option 1 — Clé API Anthropic (facturation à l'usage, console.anthropic.com)
ANTHROPIC_API_KEY=

# Option 2 — Abonnement Claude Pro/Max : token généré avec `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Modèle utilisé par défaut (surcharges possibles par type de tâche)
TPASSIST_MODEL=claude-sonnet-5-5
# TPASSIST_MODEL_INGEST=   # analyse des PDF
# TPASSIST_MODEL_TUTOR=    # aides, vérification, chat

# Délai de déblocage des aides, en secondes de temps actif sur la question (120 = 2 min)
TPASSIST_UNLOCK_DELAY_SEC=120

# Nombre d'appels IA simultanés
TPASSIST_AI_CONCURRENCY=3

# 1 = mode simulation (aucun appel à Claude, réponses factices) pour tester l'interface
TPASSIST_AI_MOCK=0

# Port local (http://localhost:3000)
TPASSIST_PORT=3000
